# ZIGNOS base system — the canonical package set.
#
# This file is the single definition of "what a base ZIGNOS system is".
# build-system.sh applies it (zpkg skips what is already installed, so it
# is idempotent — run it after every recipe-tree update to roll forward).
#
# One package name per line; '#' starts a comment. Order does not matter
# (zpkg resolves dependencies), sections are just for reading.

# toolchain and libc (kept current by zpkg; built by stage2 on bootstrap)
glibc
gcc
binutils
make

# core userland
bash
coreutils
tar
gzip
grep
sed
file
flex
pkgconf
busybox
go
zpkg

# libraries
zlib
bzip2
xz
zstd
gmp
mpfr
mpc
pcre2
libcap
libxcrypt
ncurses
readline
linux-headers
openssl
expat
libmnl

# tools that recipes build with (autoconf: kbd testsuite, bison: openssl,
# bc/elfutils: kernel build) — harmless in images, required on build hosts
autoconf
bison
bc
elfutils
m4
texinfo
diffutils
patch
findutils
gawk

# languages and scripting (adopted from the stage1 temp installs)
gettext
perl
mpdecimal
libffi
python3
ninja
meson
libevent

# system plumbing
util-linux
e2fsprogs
procps
kbd
inetutils
shadow
ca-certificates

# init and boot
openrc
initscripts
linux
grub

# network and remote access
dhcpcd
chrony
openssh
doas
# WiFi userland (authentication + radio control); the kernel side needs
# CFG80211/MAC80211 plus drivers when installing on real hardware
libnl
wpa_supplicant
iw
rfkill

# editors and everyday tools
nano
vim
less
curl
git
iproute2
wget
tmux
htop
rsync
which

# documentation (man-db formats through groff; man-pages provides the pages)
groff
gdbm
libpipeline
man-db
man-pages

# NOT in the base set on purpose:
#   sudo — lives in main/ for people who expect it (doas is the default)
